# ============================================================
# VELO DRIVER APP — environment template (self-hosted stack)
# ============================================================

# Backend API base (Android emulator uses 10.0.2.2 for host loopback).
API_BASE=http://10.0.2.2:8000

# ---- OAuth client IDs (server-side verification) ----
# GOOGLE_CLIENT_ID: if blank, the "Google" sign-in option is hidden/unsupported
# and POST /api/auth/google returns 503 on the backend (verified server-side).
GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID: if blank, Sign in with Apple is unavailable and
# POST /api/auth/apple returns 503 on the backend.
APPLE_CLIENT_ID=

# ---- Twilio (OTP delivery, backend-side) ----
# If any is blank, OTP codes are generated/verified but SMS delivery no-ops
# honestly (backend returns sent:false, warning logged).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Google Maps ----
# GOOGLE_MAPS_API_KEY: if blank, backend Places/Directions endpoints fail open
# ([] / null) and the app falls back to manual address entry / pin placement.
# The live map (react-native-maps PROVIDER_GOOGLE) also needs this key compiled
# into AndroidManifest.xml / AppDelegate for device builds.
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------
# Bare React Native note: EXPO_PUBLIC_* vars are an Expo-CLI
# convention. This app is bare RN (no Expo), so those names do
# not auto-inject. Equivalent config:
#   GOOGLE_WEB_CLIENT_ID  → required for @react-native-google-signin
#   (Android: strings.xml `default_web_client_id`; iOS: GoogleService-Info)
#   GOOGLE_MAPS_API_KEY   → AndroidManifest.xml `com.google.android.geo.API_KEY`
# ------------------------------------------------------------
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
