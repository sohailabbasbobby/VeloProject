# Disable New Architecture — react-native-maps requires PROVIDER_GOOGLE
# with Fabric/TurboModules (New Architecture). Apple Maps (default) only
# works reliably on the Old Architecture bridge. Re-enable when Google
# Maps API key is configured for production.
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

require_relative '../node_modules/react-native/scripts/react_native_pods'

platform :ios, '15.1'
prepare_react_native_project!

target 'VeloDriverApp' do
  use_react_native!(
    :path => '../node_modules/react-native',
    :hermes_enabled => true,
    :fabric_enabled => false
  )
end

post_install do |installer|
  react_native_post_install(installer)
end
