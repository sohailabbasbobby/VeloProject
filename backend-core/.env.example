# ============================================================
# VELO BACKEND CORE — environment template
# Copy to .env and fill in. Every blank optional variable is
# documented with what silently no-ops if left empty.
# ============================================================

# ---- Core (required) ----
PORT=8000
DATABASE_URL=postgres://velo_admin:CHANGE_ME@localhost:5432/velo_network
DB_POOL_MAX=20
ADMIN_KEY=change-me-platform-admin-key
CORS_ORIGINS=*

# ---- Self-hosted auth (Jawa Ride pattern) ----
# JWT_SECRET: REQUIRED for sign-in — without it (or if shorter than 32 chars)
# the auth service refuses to issue tokens (fail-closed, no insecure fallback).
JWT_SECRET=change-me-min-32-characters-long-secret!!
# GOOGLE_CLIENT_ID: if blank, POST /api/auth/google returns 503 GOOGLE_NOT_CONFIGURED
# and the "Google" option reports unavailable in GET /api/auth/providers.
GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID: if blank, POST /api/auth/apple returns 503 APPLE_NOT_CONFIGURED
# and the "Apple" option reports unavailable in GET /api/auth/providers.
APPLE_CLIENT_ID=

# ---- OTP delivery via Twilio plain REST ----
# TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM_NUMBER: if ANY is blank,
# OTP codes are still generated/verified but SMS delivery becomes an honest
# no-op (response `sent: false`, warning logged — the code is NOT fabricated).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_PROXY_SERVICE_SID: if blank, masked-call proxy setup logs and fails per-request
# (trip contact exchange returns an explicit error instead of silent spoofing).
TWILIO_PROXY_SERVICE_SID=

# ---- Stripe Connect (escrow) ----
# If blank, escrow records stay in AWAITING_CAPTURE with intent data and
# capture/release endpoints fail closed (never fake a successful charge).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Google Maps Platform ----
# GOOGLE_MAPS_API_KEY: if blank, route metrics/ETA/quoting fall back to
# honest estimates (MapsService throws / Places endpoints return []).
GOOGLE_MAPS_API_KEY=

# ---- AI / OCR document verification ----
# If blank, document verification requests return 503 AI_NOT_CONFIGURED
# (documents stay PENDING — no fake verdicts).
OPENAI_API_KEY=

# ---- Legacy (removed after self-hosted auth swap) ----
# FIREBASE_* variables are no longer used by backend-core auth. Push delivery
# still goes through FCM at the OS level; wire APNs/FCM credentials here when
# configuring push, or leave blank (push becomes a no-op, in-app records persist).
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_PROJECT_ID=
